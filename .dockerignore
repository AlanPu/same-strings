# 构建上下文只需要 dist/site 与 nginx.conf，其余一律不发给 Docker 守护进程
.venv/
work/
.git/
.gitignore
.workbuddy/
__pycache__/
*.pyc
build.log

# 单文件内联版产物不用进镜像（那是 AirDrop 给 iPad 的那份）
dist/同弦.html
dist/bank.json

# 参照页（8 个原视频 + 对比音轨，约 3 GB）只在本机/局域网用，绝不进构建上下文。
# 漏了这一条不会报错，但每次 build 都要把 3 GB 先发给守护进程，慢到像卡死。
dist/ref

# README 的截图，只在仓库里给 GitHub 用
docs/

